{
  "name": "idris",
  "scopeName": "source.idris",
  "fileTypes": ["idr"],
  "patterns": [
    { "include": "#docComment" },
    { "include": "#lineComment" },
    { "include": "#blockComment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#pragma" },
    { "include": "#signature" },
    { "include": "#keyword" },
    { "include": "#hole" },
    { "include": "#backtickInfix" },
    { "include": "#type" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "docComment": {
      "name": "comment.block.documentation.idris",
      "match": "\\|\\|\\|.*$"
    },
    "lineComment": {
      "name": "comment.line.double-dash.idris",
      "match": "--.*$"
    },
    "blockComment": {
      "name": "comment.block.idris",
      "begin": "\\{-",
      "end": "-\\}"
    },
    "string": {
      "name": "string.quoted.double.idris",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.idris", "match": "\\\\." }
      ]
    },
    "char": {
      "name": "string.quoted.single.idris",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    "pragma": {
      "name": "keyword.other.pragma.idris",
      "match": "%[a-zA-Z_]+"
    },
    "signature": {
      "match": "^\\s*(?:export\\s+|public\\s+export\\s+|covering\\s+|total\\s+|partial\\s+)*([a-z][a-zA-Z0-9_']*)\\s*:(?![:=])",
      "captures": {
        "1": { "name": "entity.name.function.idris" }
      }
    },
    "keyword": {
      "name": "keyword.control.idris",
      "match": "\\b(module|import|public|export|data|record|where|constructor|do|case|of|if|then|else|let|in|mutual|namespace|interface|implementation|using|rewrite|with|impossible|covering|total|partial|forall|auto)\\b"
    },
    "hole": {
      "name": "constant.language.hole.idris",
      "match": "\\?[a-zA-Z_][a-zA-Z0-9_']*"
    },
    "backtickInfix": {
      "name": "keyword.operator.function.infix.idris",
      "match": "`[a-zA-Z_][a-zA-Z0-9_']*`"
    },
    "type": {
      "name": "entity.name.type.idris",
      "match": "\\b[A-Z][a-zA-Z0-9_']*\\b"
    },
    "number": {
      "name": "constant.numeric.idris",
      "match": "\\b[0-9]+\\b"
    },
    "operator": {
      "name": "keyword.operator.idris",
      "match": "->|=>|<-|::|\\+\\+|&&|\\|\\||>>=|<\\*>|<\\|>|<\\+>|\\*>|<\\*|\\$|=|:|\\||(?<= )\\.(?= )"
    }
  }
}
