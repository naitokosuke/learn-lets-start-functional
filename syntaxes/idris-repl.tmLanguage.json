{
  "name": "idris-repl",
  "scopeName": "source.idris-repl",
  "fileTypes": [],
  "patterns": [
    {
      "begin": "^([A-Za-z][A-Za-z0-9_.]*>)\\s",
      "beginCaptures": {
        "1": { "name": "entity.name.function.prompt.idris-repl" }
      },
      "end": "$",
      "patterns": [
        { "name": "keyword.other.command.idris-repl", "match": "\\G:[a-z?]+" },
        { "include": "source.idris" }
      ]
    },
    { "name": "keyword.control.error.idris-repl", "match": "^Error:.*$" }
  ]
}
